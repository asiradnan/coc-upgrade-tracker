<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#165294" />
            <corners android:radius="9dp" />
            <stroke
                android:width="1.5dp"
                android:color="#171512" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#2682DE"
                android:startColor="#52B4FF" />
            <corners android:radius="7.5dp" />
        </shape>
    </item>
</layer-list>
